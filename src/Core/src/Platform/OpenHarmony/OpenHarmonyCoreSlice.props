<Project>
  <!--
    OpenHarmony slice files that compile into Microsoft.Maui.Core. This list is the single
    source of truth for the Core/Controls split: Core.csproj includes it, Controls.Core.csproj
    removes the same files from its slice glob. The remaining slice files consume
    Microsoft.Maui.Controls concrete types and stay in Microsoft.Maui.Controls.
  -->
